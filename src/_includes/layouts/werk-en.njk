---
layout: layouts/base.njk
lang: en
navActive: galerie
langSwitchUrl: /galerie/
orderUrl: /en/ordering/
backUrl: /en/gallery/
backLabel: "← Back to gallery"
orderLabel: Order this piece
labels:
  ort: Location
  jahr: Year taken
  papier: Paper
  formate: Sizes
  preis: Price from
---
<main>
  <section class="section--tight">
    <div class="container">
      <p><a href="{{ backUrl }}" class="text-link">{{ backLabel }}</a></p>

      <div class="work-detail" style="margin-top: 1.5rem;">
        <div>
          <div class="frame">
            <img src="{{ image }}" alt="{{ imageAlt }}">
          </div>
        </div>

        <div class="work-meta">
          <h1 style="font-size: clamp(1.9rem, 3.5vw, 2.6rem);">{{ title }}</h1>
          <p>{{ content | safe }}</p>

          <dl>
            <dt>{{ labels.ort }}</dt>
            <dd>{{ place }}</dd>
            <dt>{{ labels.jahr }}</dt>
            <dd>{{ year }}</dd>
            <dt>{{ labels.papier }}</dt>
            <dd>{{ paper }}</dd>
            <dt>{{ labels.formate }}</dt>
            <dd>{{ sizes }}</dd>
            <dt>{{ labels.preis }}</dt>
            <dd>€{{ priceFrom }}</dd>
          </dl>

          <a href="{{ orderUrl }}" class="btn btn--solid">{{ orderLabel }}</a>
        </div>
      </div>
    </div>
  </section>
</main>
